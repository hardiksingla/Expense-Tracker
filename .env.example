# Gemini API key(s), comma-separated if you want key rotation
GEMINI_API_KEY=

# Telegram bot configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_ADMIN_TOKEN=add-random-long-string
PUBLIC_BASE_URL=https://your-public-domain.example

# Google Sheets configuration
# Use either this JSON value (serverless/Vercel) or a local credentials.json file.
GOOGLE_CREDENTIALS=

# Telegram-spreadsheet link
<TELEGRAM_ID>_SPREADSHEET_ID=

# Optional local server port
PORT=3000

# Telegram users use <telegram_username>_SPREADSHEET_ID variables.
# Example:
# vaibhav_SPREADSHEET_ID=
